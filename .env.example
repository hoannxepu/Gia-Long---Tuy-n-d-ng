# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PIN: Mã PIN bảo mật cao để đăng nhập Bảng Quản Trị (/api/admin/*)
# BẮT BUỘC: Không có giá trị mặc định. Nếu thiếu biến này máy chủ sẽ từ chối truy cập admin.
# Trên Cloudflare Pages: chạy lệnh `wrangler secret put ADMIN_PIN`
ADMIN_PIN="YOUR_SECURE_ADMIN_PIN_HERE"

# SIGNING_SECRET: Chuỗi bí mật dùng cho ký mã bảo mật
# Trên Cloudflare Pages: chạy lệnh `wrangler secret put SIGNING_SECRET`
SIGNING_SECRET="YOUR_SECURE_SIGNING_SECRET_HERE"

# ED25519_PRIVATE_KEY: (Tùy chọn) PEM private key nếu muốn thay đổi cặp khóa ký bản quyền Ed25519
# ED25519_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
